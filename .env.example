# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ── Numi AI (optional; see README) ───────────────────────────────────────────
AI_BASE_URL=""
