AI_API_KEY=""

# ── PayPal (required once you enable paid plans) ─────────────────────────────
# 1) Create an app at https://developer.paypal.com → Apps & Credentials.
# 2) Sandbox: use the "Sandbox" client id/secret. Live: switch to "Live".
# 3) Set up a Webhook (https://developer.paypal.com → Webhooks) pointing to
#    https://<your-domain>/api/paypal/webhook and copy the Webhook ID.
# 4) PAYPAL_ENV must be "sandbox" or "live"; defaults to "sandbox".
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
